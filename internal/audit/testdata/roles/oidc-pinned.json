{
  "RoleName": "GithubDeployMain",
  "Arn": "arn:aws:iam::111122223333:role/GithubDeployMain",
  "AssumeRolePolicyDocument": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Effect": "Allow",
        "Principal": {
          "Federated": "arn:aws:iam::111122223333:oidc-provider/token.actions.githubusercontent.com"
        },
        "Action": "sts:AssumeRoleWithWebIdentity",
        "Condition": {
          "StringEquals": {
            "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
            "token.actions.githubusercontent.com:sub": "repo:moveeeax/app:ref:refs/heads/main"
          }
        }
      }
    ]
  }
}
